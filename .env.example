# Never commit real credentials. Configure these in Vercel Settings > Environment Variables.
# Online mode is enabled automatically by Vercel. To test hosted mode locally: PIA_HOSTED=1
# Generate at least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
PIA_ACCESS_KEY=
PIA_USERNAME=pia
DATABASE_URL=
PIA_PROVIDER=bedrock
PIA_MODEL_ID=
PIA_AWS_REGION=eu-central-1
BRAVE_API_KEY=
# For Bedrock: provide AWS credentials securely via the deployment environment.
# For direct Anthropic instead: PIA_PROVIDER=anthropic and ANTHROPIC_API_KEY=...
# No investment capital or actual account data belongs in this file.
